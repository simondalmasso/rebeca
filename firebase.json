{
  "hosting": {
    "site": "rebeca-sf",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://rebeca-sf.simondalmasso44.workers.dev/",
        "type": 301
      },
      {
        "source": "/:path*",
        "destination": "https://rebeca-sf.simondalmasso44.workers.dev/:path",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  }
}
